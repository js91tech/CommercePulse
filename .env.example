# Neon Postgres (required). Use the Neon non-pooling / "direct" URL for both.
# Vercel: Storage → Neon, then set these on the project. Pooling is optional later.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/commercepulse?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/commercepulse?sslmode=require"

# Local Docker instead of Neon (`docker compose up db`):
# DATABASE_URL="postgresql://commercepulse:commercepulse@localhost:5432/commercepulse"
# DIRECT_URL="postgresql://commercepulse:commercepulse@localhost:5432/commercepulse"

# Optional live enrichment. The app always works with mock fallbacks.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
SERPAPI_KEY=""
